# Copy to .env at the repository root. Use your own local database password.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragvault
POSTGRES_USER=ragvault
POSTGRES_PASSWORD=replace-with-your-local-password
DATABASE_TIMEOUT_SECONDS=3

# Native Windows backend -> Windows Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Containerized backend -> Windows Ollama
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=3
# Chat model is reserved; semantic search uses only the embedding model.
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Public browser configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000

# Native storage defaults to data/uploads relative to this repository.
# UPLOAD_DIR=C:/path/to/RAGVault/data/uploads
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=2000
PDF_VALIDATION_TIMEOUT_SECONDS=15

# Milestone 3: character-based page-local chunking (not model token counts).
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
PROCESSING_TIMEOUT_SECONDS=60
MAX_PAGE_TEXT_CHARS=100000
MAX_EXTRACTED_CHARS=1000000
MAX_DOCUMENT_CHUNKS=5000

# Milestone 4: bounded, local Ollama indexing and exact pgvector search.
EMBEDDING_TIMEOUT_SECONDS=60
INDEXING_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=16
MAX_INDEX_CHUNKS=2000
MAX_INDEX_VECTOR_VALUES=2000000
MAX_EMBEDDING_DIMENSIONS=4096
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
SEARCH_TOP_K=5
